# ─────────────────────────────────────────────────────────────
# HelpDesk Pro — environment template
# Copy the API section to  apps/api/.env  and fill in values.
# The web app needs no env vars in dev (Vite proxy handles /api).
# NEVER commit real .env files or secrets.
# ─────────────────────────────────────────────────────────────

# ── apps/api/.env ────────────────────────────────────────────

# PostgreSQL connection.
#   Local Homebrew Postgres 16 (default dev path on this machine):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/helpdesk
#   Docker Compose (db service maps host 5433 → container 5432):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/helpdesk

# Secret used to sign/derive session tokens. Generate with:
#   openssl rand -hex 48
SESSION_SECRET=replace-me-with-64-random-hex-chars

# API server port
PORT=4000

# Allowed browser origin(s) for CORS — comma-separated if multiple
WEB_ORIGIN=http://localhost:5173

# Local attachment storage (dev only). Production uses S3/R2.
UPLOAD_DIR=./uploads

# Max attachment size in megabytes
MAX_UPLOAD_MB=10

# development | test | production
NODE_ENV=development

# ── apps/web/.env (production only; dev uses Vite proxy) ─────
# VITE_API_URL=https://your-api-domain.example.com
